# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
# ...except the documentation template — no secrets, just variable names.
!.env.local.example

# local screenshots taken during manual/dev verification — never committed.
/screenshots/

# Google Cloud service-account keys — NEVER commit any SA key JSON.
# Note: a blanket `*.json` would wrongly ignore package.json/tsconfig.json, so we
# target credential file patterns explicitly.
*-sa.json
*-key.json
*-credentials.json
service-account*.json
market-research-bq.json
*.gcp.json
/secrets/
/.gcp-keys/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
server.out.log
