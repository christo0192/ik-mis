# ---------------------------------------------------------------------------
# Market Research Dashboard — environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for local overrides. DO NOT commit .env.local or any key.
#
# BigQuery is SERVER-SIDE ONLY. None of these are exposed to the browser
# (no NEXT_PUBLIC_ prefix), so the credential never reaches client code.

# Base64-encoded Google Cloud service-account JSON, used in production (Vercel).
# Generate it from the SA key file. On Windows PowerShell:
#
#   [Convert]::ToBase64String(
#     [IO.File]::ReadAllBytes("C:\Users\Admin\.gcp-keys\market-research-bq.json")
#   ) | Set-Content -NoNewline sa.b64
#
# On macOS/Linux:
#   base64 -w0 market-research-bq.json
#
# Then paste the single-line value as the Vercel env var MARKET_RESEARCH_BQ_SA_B64.
#
# Locally you do NOT need this — the app falls back to the local key file at
# C:\Users\Admin\.gcp-keys\market-research-bq.json automatically.
MARKET_RESEARCH_BQ_SA_B64=

# Local-dev-only override: point at any SA key file directly (e.g. a key with
# different/broader dataset grants than the default market-research-bq.json).
# Takes precedence over the hardcoded LOCAL_KEY_FILES fallback in bq.ts, but
# MARKET_RESEARCH_BQ_SA_B64 above still wins if both are set.
MARKET_RESEARCH_BQ_KEY_FILE=

# Review write-route auth (src/app/api/generation/review/route.ts). Both
# optional; default is fail-closed (writes disabled). See DEPLOY.md §4.
MIS_REVIEW_TOKEN=
MIS_ALLOW_SAME_ORIGIN_WRITES=
